# === Dependencies (restored via composer / pnpm — never commit) ===
/vendor/
/node_modules/
/apps/admin/node_modules/

# Keep lock files tracked (reproducible installs): composer.lock, pnpm-lock.yaml

# === Build / test caches ===
/.phpunit.cache/
/.phpunit.result.cache
/apps/admin/.vite/
*.log

# === OS / editor cruft ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~

# === Local WP / env ===
.env
.env.local

# Built admin bundle — regenerated by `pnpm run build` and bundled into the
# release zip by release.sh, so it is not tracked in git.
/assets/dist/

# Release build output
/build/
